{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm add:*)",
      "Bash(pnpm remove:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm format:*)",
      "Bash(pnpm check:*)",
      "Bash(pnpm check-types:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm db:generate:*)",
      "Bash(pnpm db:start)",
      "Bash(pnpm db:stop)",
      "Bash(pnpm env:generate)",
      "Bash(pnpm exec oxlint:*)",
      "Bash(pnpm exec oxfmt:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)"
    ],
    "ask": [
      "Bash(pnpm db:push:*)",
      "Bash(pnpm db:migrate:*)",
      "Bash(git push:*)",
      "Bash(docker compose down:*)"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-edited-file.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
