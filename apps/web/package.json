    "@types/react": "^19.3.0",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "web-vitals": "^6.2.3"
